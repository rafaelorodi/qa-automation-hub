# Configuración de pruebas - Selecciona qué historias de usuario ejecutar
# Formato: HU001,HU002,HU003 o dejar vacío para ejecutar todas

# Para ejecución local (comenta/descomenta según necesites):
RUN_PLAYWRIGHT_HUS=HU001
RUN_KARATE_HUS=HU001

# Para GitHub Actions (se puede sobrescribir desde workflow):
# RUN_PLAYWRIGHT_HUS=HU001,HU002,HU003
# RUN_KARATE_HUS=HU001,HU002,HU003
